{
  "name": "panditjiexpress",
  "version": "1.0.0",
  "description": "Best North Indian Pandit in Bangalore - Pandit Ji Express",
  "private": true,
  "scripts": {
    "dev": "npx -y serve . -p 8080",
    "validate-business": "node scripts/validate.js validate-business",
    "typecheck": "node scripts/validate.js typecheck",
    "lint": "node scripts/validate.js lint",
    "format:check": "node scripts/validate.js format:check",
    "build": "node scripts/validate.js build",
    "test:agent": "node scripts/test_agent_readiness.js",
    "deploy": "npx wrangler pages deploy . --project-name panditjiexpress",
    "deploy:preview": "npx wrangler pages deploy . --project-name panditjiexpress --branch preview"
  },
  "devDependencies": {
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260917.1": true
  }
}
